# CareBridge AI - Environment Configuration

# Application
APP_NAME="CareBridge AI"
APP_ENV="development"
PORT=8000
HOST="0.0.0.0"
SECRET_KEY="carebridge-ai-super-secret-production-key-change-in-prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Uses SQLite locally out-of-the-box for instant zero-dependency hackathon testing & evaluation
# Or PostgreSQL/Supabase when SUPABASE_DB_URL is supplied
DATABASE_URL="sqlite:///./carebridge.db"

# Supabase (Optional for live hosted Supabase instance)
SUPABASE_URL="https://mock-carebridge-supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.mock-service-role"

# Demo Mode
DEMO_MODE=True

